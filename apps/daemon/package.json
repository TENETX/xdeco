{
  "name": "@xdeco/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "xdeco": "./dist/cli.js"
  },
  "scripts": {
    "build:widget": "node scripts/build-widget-styles.mjs",
    "dev:http": "tsx watch src/http.ts",
    "start:http": "tsx src/http.ts",
    "mcp": "tsx src/mcp.ts",
    "cli": "tsx src/cli.ts",
    "prebuild": "pnpm build:widget",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm build:widget",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm build:widget",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@xdeco/shared": "workspace:*",
    "lucide": "^1.33.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "latest",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tsx": "latest",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest"
  }
}
