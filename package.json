{
  "name": "xdeco",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @xdeco/daemon dev:http\" \"pnpm --filter @xdeco/web dev\"",
    "start:web": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @xdeco/daemon start:http\" \"pnpm --filter @xdeco/web start\"",
    "build": "pnpm -r build",
    "build:plugin": "pnpm --filter @xdeco/daemon build:widget && esbuild apps/daemon/src/mcp.ts --bundle --platform=node --format=cjs --target=node22 --outfile=plugins/xdeco/scripts/mcp.cjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @xdeco/daemon test",
    "validate:plugin": "bash scripts/validate-plugin.sh"
  },
  "devDependencies": {
    "concurrently": "latest",
    "esbuild": "^0.28.2",
    "typescript": "latest"
  }
}
